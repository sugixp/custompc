# Copy to .env and adjust. Never commit .env.

# Host port for the Postgres in docker-compose.yml. If 5432 is already taken
# (e.g. by a Postgres installed on the machine), use another port such as 5433
# and change it in DATABASE_URL too.
POSTGRES_PORT=5432

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://custompc:custompc@localhost:5432/custompc"

# Price providers for `npm run prices:sync`, comma-separated. "seed" is the
# built-in provider with illustrative prices; other entries are module names
# of separately installed provider packages (see docs/architecture.md).
# PRICE_PROVIDERS=seed
